# OpenVibe.Domains — environment (production: /etc/openvibe/domains.env). Names only; never commit values.

NODE_ENV=production
PORT=5070
HOST=127.0.0.1
BASE_URL=https://openvibe.domains
TRUST_PROXY=2

# The two public services this front reads. Both fall back to the internal origin in the pinned
# openvibe-contracts manifest; Tools has https://openvibe.tools if its manifest ever loses one.
# OV_HOST_INTERNAL_URL=http://127.0.0.1:4910
# OV_TOOLS_INTERNAL_URL=http://127.0.0.1:4001

# The shared per-IP budget for /api/v1 and /search, and the data clients' timeout.
# DOMAINS_RATE_LIMIT_PER_MIN=120
# DOMAINS_UPSTREAM_TIMEOUT_MS=8000
